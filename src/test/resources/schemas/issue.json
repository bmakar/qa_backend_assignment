{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "title": "GitLab issue",
  "description": "Structural contract for a single issue. Deliberately asserts types and required fields only - not the full field list - so that GitLab adding a field does not fail the build, while a field changing type or disappearing does.",
  "type": "object",
  "required": [
    "id",
    "iid",
    "project_id",
    "title",
    "state",
    "labels",
    "confidential",
    "web_url",
    "created_at",
    "updated_at",
    "author"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "iid": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Not constrained by maxLength on purpose. The 255-character limit is request validation, asserted by IssueBoundaryTest.acceptsTitleAtMaximumLength and rejectsTitleBeyondMaximumLength against Issue.TITLE_MAX_LENGTH. Asserting it here would instead claim the API never RETURNS a longer title, so raising the limit would fail every read of a legitimately created issue rather than the one boundary test meant to detect the change. minLength is different: an issue always having a non-empty title is a genuine response invariant."
    },
    "description": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "opened",
        "closed"
      ]
    },
    "issue_type": {
      "type": "string"
    },
    "labels": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidential": {
      "type": "boolean"
    },
    "due_date": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "web_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "closed_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": "object",
      "required": [
        "id",
        "username"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "username": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "web_url": {
          "type": "string"
        }
      }
    },
    "assignees": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "username"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "username": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
